        "comment-parser": "^1.4.7",
        "dompurify": "^3.4.13",
        "dotenv": "^17.4.2",
        "font-awesome": "^4.7.0",
        "glob": "^11.1.0",
        "interactjs": "^1.10.28",
        "laravel-precognition-vue-inertia": "^0.8.0",
        "marked": "^17.0.6",
        "mysql-mcp": "^1.1.1",
        "mysql2": "^3.23.2",
        "photoswipe": "^5.4.4",
        "pikaday": "^1.8.2",
        "pinia": "^3.0.4",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "puppeteer": "^24.43.1",
        "vanilla-tilt": "^1.8.1"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-darwin-arm64": "4.3.0",
        "@tailwindcss/oxide-darwin-x64": "4.3.0",
        "@tailwindcss/oxide-linux-arm64-gnu": "4.3.0",
