{
  "version": 1,
  "source": "dofusdb",
  "entity": "spell",
  "label": "Sorts",
  "meta": {
    "notes": "DofusDB : spell + spell-levels (plusieurs niveaux). Les paramètres globaux sont lus depuis spell_global, construit par SpellGlobalNormalizer (spell racine + levels[0] + area = premier effet). Mapping uniquement paramètres globaux ; les effets sont traités par SpellEffectsConversionService."
  },
  "endpoints": {
    "fetchOne": {
      "pathTemplate": "/spells/{id}",
      "method": "GET",
      "queryDefaults": { "lang": "fr" }
    },
    "fetchMany": {
      "path": "/spells",
      "method": "GET",
      "queryDefaults": { "lang": "fr", "$limit": 50, "$skip": 0 }
    }
  },
  "filters": {
    "supported": [
      { "key": "id", "type": "number" },
      { "key": "idMin", "type": "number" },
      { "key": "idMax", "type": "number" },
      { "key": "name", "type": "string" },
      { "key": "breedId", "type": "number" }
    ]
  },
  "target": {
    "krosmozEntity": "spell",
    "primaryKey": { "sourceField": "id", "targetField": "dofusdb_id" },
    "autoUpdateField": "auto_update"
  },
  "mapping": [
    { "key": "dofusdb_id", "from": { "path": "spell_global.id" }, "to": [{ "model": "spells", "field": "dofusdb_id" }], "formatters": [{ "name": "toString", "args": {} }] },
    { "key": "name", "from": { "path": "spell_global.name", "langAware": true }, "to": [{ "model": "spells", "field": "name" }], "formatters": [{ "name": "pickLang", "args": { "lang": "fr", "fallback": "fr" } }] },
    { "key": "description", "from": { "path": "spell_global.description", "langAware": true }, "to": [{ "model": "spells", "field": "description" }], "formatters": [{ "name": "pickLang", "args": { "lang": "fr", "fallback": "fr" } }, { "name": "truncate", "args": { "max": 255 } }] },
    { "key": "image", "from": { "path": "spell_global.img" }, "to": [{ "model": "spells", "field": "image" }], "formatters": [{ "name": "storeScrappedImage", "args": { "entityFolder": "spells", "idPath": "id" } }] },
    { "key": "pa", "from": { "path": "spell_global.apCost" }, "to": [{ "model": "spells", "field": "pa" }], "formatters": [{ "name": "toInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "action_points_spell" } }] },
    { "key": "spell_po_min", "from": { "path": "spell_global.minRange" }, "to": [{ "model": "spells", "field": "spell_po_min" }], "formatters": [{ "name": "nullableInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "spell_range_min_spell" } }] },
    { "key": "spell_po_max", "from": { "path": "spell_global.range" }, "to": [{ "model": "spells", "field": "spell_po_max" }], "formatters": [{ "name": "nullableInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "spell_range_max_spell" } }] },
    { "key": "level", "from": { "path": "spell_global.minPlayerLevel" }, "to": [{ "model": "spells", "field": "level" }], "formatters": [{ "name": "toInt", "args": {} }, { "name": "convertCharacteristic", "args": {} }, { "name": "toString", "args": {} }], "characteristic_key": "level_spell" },
    { "key": "cast_per_turn", "from": { "path": "spell_global.maxCastPerTurn" }, "to": [{ "model": "spells", "field": "cast_per_turn" }], "formatters": [{ "name": "toInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "cast_per_turn_spell" } }, { "name": "toString", "args": {} }] },
    { "key": "cast_per_target", "from": { "path": "spell_global.maxCastPerTarget" }, "to": [{ "model": "spells", "field": "cast_per_target" }], "formatters": [{ "name": "nullableInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "cast_per_target_spell" } }, { "name": "toString", "args": {} }] },
    { "key": "sight_line", "from": { "path": "spell_global.castTestLos" }, "to": [{ "model": "spells", "field": "sight_line" }], "formatters": [{ "name": "toInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "sight_line_spell" } }] },
    { "key": "cast_in_line", "from": { "path": "spell_global.castInLine" }, "to": [{ "model": "spells", "field": "cast_in_line" }], "formatters": [{ "name": "toInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "cast_in_line_spell" } }], "characteristic_key": "cast_in_line_spell" },
    { "key": "cast_in_diagonal", "from": { "path": "spell_global.castInDiagonal" }, "to": [{ "model": "spells", "field": "cast_in_diagonal" }], "formatters": [{ "name": "toInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "cast_in_diagonal_spell" } }], "characteristic_key": "cast_in_diagonal_spell" },
    { "key": "target_type", "from": { "path": "spell_global.targetType" }, "to": [{ "model": "spells", "field": "target_type" }], "formatters": [], "characteristic_key": "target_type_spell" },
    { "key": "max_stack", "from": { "path": "spell_global.maxStack" }, "to": [{ "model": "spells", "field": "max_stack" }], "formatters": [{ "name": "toInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "max_stack_spell" } }], "characteristic_key": "max_stack_spell" },
    { "key": "global_cooldown", "from": { "path": "spell_global.globalCooldown" }, "to": [{ "model": "spells", "field": "global_cooldown" }], "formatters": [{ "name": "toInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "global_cooldown_spell" } }], "characteristic_key": "global_cooldown_spell" },
    { "key": "number_between_two_cast", "from": { "path": "spell_global.minCastInterval" }, "to": [{ "model": "spells", "field": "number_between_two_cast" }], "formatters": [{ "name": "nullableInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "number_between_two_cast_spell" } }, { "name": "toString", "args": {} }] },
    { "key": "po_editable", "from": { "path": "spell_global.rangeCanBeBoosted" }, "to": [{ "model": "spells", "field": "po_editable" }], "formatters": [{ "name": "toInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "range_editable_spell" } }] },
    { "key": "category", "from": { "path": "spell_global.categoryId" }, "to": [{ "model": "spells", "field": "category" }], "formatters": [{ "name": "nullableInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "category_spell" } }] },
    { "key": "powerful", "from": { "path": "spell_global.powerful" }, "to": [{ "model": "spells", "field": "powerful" }], "formatters": [{ "name": "nullableInt", "args": {} }, { "name": "clampToCharacteristic", "args": { "characteristicId": "power_spell" } }] }
  ]
}
