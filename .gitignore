.env
.env.testing
.env.backup
.env.production

# Storage Laravel (clés, logs, cache applicatif)
/storage/*.key
/storage/pail
/storage/app/seeders-data-backups
/storage/app/dev-reports
/storage/debugbar
/storage/framework
/storage/logs
/torage/media-library
