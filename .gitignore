/storage/app/purified

# Cache PHPStan (tmpDir dans phpstan.neon)
/storage/phpstan/

# Fichiers temporaires Spatie Media Library
/storage/media-library/temp/

# Disques fake PHPUnit / tests (artefacts générés en local)
/storage/framework/testing/disks/

# Vite HMR (équivalent de /public/hot)
/storage/framework/vite.hot

# Fichiers générés par laravel-ide-helper (régénérer en local : php artisan ide-helper:generate)
/_ide_helper.php
/_ide_helper_models.php
/.phpstorm.meta.php

# --- Frontend / build ---
/public/build
/public/hot
/public/storage

# Fichiers SCSS compilés (public)
/public/css/*.css
/public/css/*.css.map

# Cache outils frontend
.eslintcache
*.tsbuildinfo
node_modules/.vite

# --- Tests & qualité ---
/coverage/
/test-results/
/playwright-report/
/blob-report/

# Pint
.pint.cache

# Exports HTML legacy (spécialisations) — générés localement
/database/seeders/data/legacy-specializations/*.html

# Base SQLite locale
/database/*.sqlite

