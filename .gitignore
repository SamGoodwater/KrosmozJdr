# --- Laravel / PHP ---
/.phpunit.cache
.phpunit.result.cache
.phpactor.json
auth.json
Homestead.json
Homestead.yaml
docker-compose.override.yml

# Cache & bootstrap compilés
/bootstrap/ssr
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Dépendances
/node_modules
/vendor

# Environnement
.env
.env.testing
.env.backup
.env.production

# --- Storage Laravel ---
# Structure versionnée : .gitignore imbriqués sous storage/app, storage/framework, etc.
# Disque public versionné : storage/app/public/** sauf images/entity et images/users
# (voir storage/app/public/.gitignore). Le lien public/storage n'est pas versionné.

/storage/*.key
/storage/pail

# Outils & exports locaux (storage/app/* sauf public/ et private/ — voir storage/app/.gitignore)
/storage/app/backups
/storage/app/dev-reports
/storage/app/purified
/storage/app/seeders-data-backups
/storage/app/characteristics_*_samples.json

# Contenu privé utilisateur (structure .gitignore versionnée)
/storage/app/private/*
!/storage/app/private/.gitignore

# Cache PHPStan (tmpDir dans phpstan.neon)
/storage/phpstan/

# Fichiers temporaires Spatie Media Library
/storage/media-library/temp/

# Disques fake PHPUnit (artefacts générés en local)
/storage/framework/testing/disks/

# Vite HMR (équivalent de /public/hot)
/storage/framework/vite.hot

# Fichiers générés par laravel-ide-helper
# Régénérer en local : php artisan ide-helper:generate && ide-helper:models && ide-helper:meta
/_ide_helper.php
/_ide_helper_models.php
/.phpstorm.meta.php

# --- Frontend / build ---
/public/build
/public/hot
# Lien `php artisan storage:link` → storage/app/public (ne pas versionner le symlink)
/public/storage

# Fichiers SCSS compilés (public)
/public/css/*.css
/public/css/*.css.map

# Cache outils frontend
.eslintcache
*.tsbuildinfo
node_modules/.vite

# --- Tests & qualité ---
/coverage/
/test-results/
/playwright-report/
/blob-report/

# Pint
.pint.cache

# Exports HTML legacy (spécialisations) — générés localement
/database/seeders/data/legacy-specializations/*.html

# Base SQLite locale
/database/*.sqlite

# --- IDE & éditeurs ---
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.pnpm-store
/.obsidian
desktop.ini

# Cursor (secrets MCP ; les rules restent versionnées)
.cursor/mcp.json

# --- Divers ---
npm-debug.log
yarn-error.log
pnpm-debug.log
/screenshots

# OS
.DS_Store
Thumbs.db

# Logs hors storage/logs/.gitignore
*.log

/test-results
/playwright-report
/blob-report

/.cursor/*.json